#!/usr/bin/env bash

# Quick UTF-8 validator script.


strings=(

       "$@"
       'foo'
       'bar'
       $'a\xffb'
       $'\x80'
)

for s in "${strings[@]}"; do
      echo -n "testing: ${s@Q}... "

      printf '%s' "$s" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 && {
          echo 'valid'
      } || { echo 'invalid'; }
done

