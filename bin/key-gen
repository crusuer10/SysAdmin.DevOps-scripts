#!/usr/bin/env bash


# The following script generates the two private/public
# keys and sends the public key to the server.

# License: MIT

SERVER_NAME="blank"
SERVER_IP="172.225.243.171"

     command -v ssh >/dev/null && {

	ssh-keygen -b 4096 
	ssh-copy-id "${SERVER_NAME}"@"${SERVER_IP}"
     }

     printf "public key sent to the server ${SERVER_NAME}\n"
